# Routine B fire config — copy to .env and fill from the "Generate token"
# output shown ONCE in the Routine B edit panel, the exact moment it appears.
# Do NOT commit .env.

# The per-routine /fire endpoint shown with the generated token.
ROUTINE_B_FIRE_URL=

# The bearer token shown exactly once. No way to recover it later.
ROUTINE_B_FIRE_TOKEN=